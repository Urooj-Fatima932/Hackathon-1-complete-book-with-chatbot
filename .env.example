# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real keys to version control!

# Cohere API Key - Get from https://dashboard.cohere.com/
COHERE_API_KEY=your_cohere_api_key_here

# Qdrant Vector Database - Get from https://cloud.qdrant.io/
QDRANT_URL=https://your-qdrant-url.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Neon Postgres Database - Get from https://console.neon.tech/
DATABASE_URL=postgres://user:password@ep-xxx.us-east-1.aws.neon.tech/chatbot?sslmode=require

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379

# Application Settings
ENVIRONMENT=production
LOG_LEVEL=info
